#!/bin/sh
# Nissho futami-reservation pre-commit hook
# 1. マージコンフリクトマーカー検出
# 2. HTML 内 inline script の JS syntax チェック
# 3. 料金表 SSOT 照合テスト（scripts/verify_pricing.js）
# 4. 平文 credential の簡易検出（STAFF_API_KEY 等）
# 5. SHEET_HEADERS 変更タグ強制（2026-05-05 Phase B-3 追加）
#
# Bypass: `git commit --no-verify` (非推奨・PR レビュー必須)

set -e

FAIL=0

# ===== 1. merge conflict marker check =====
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED" ]; then
  for f in $STAGED; do
    if [ -f "$f" ]; then
      if grep -nE '^(<{7}|={7}|>{7})( |$)' "$f" > /tmp/_pc_conflict.txt; then
        echo "❌ merge conflict marker found in: $f"
        cat /tmp/_pc_conflict.txt
        FAIL=1
      fi
    fi
  done
  rm -f /tmp/_pc_conflict.txt
fi

# ===== 2. HTML inline script syntax check =====
HTML_FILES=$(echo "$STAGED" | grep -E '\.html$' || true)
if [ -n "$HTML_FILES" ]; then
  for f in $HTML_FILES; do
    [ -f "$f" ] || continue
    node -e "
      const fs = require('fs');
      const html = fs.readFileSync('$f', 'utf8');
      const re = /<script(?![^>]*\bsrc=)(?![^>]*\btype=\"module\")[^>]*>([\\s\\S]*?)<\\/script>/g;
      let m, i = 0, errors = 0;
      while ((m = re.exec(html)) !== null) {
        i++;
        try { new Function('\"use strict\";\n' + m[1]); }
        catch (e) {
          errors++;
          console.error('❌ $f script#' + i + ': ' + e.message);
        }
      }
      if (errors > 0) process.exit(1);
    " || FAIL=1
  done
fi

# ===== 3. 料金表 SSOT 照合テスト =====
# index.html / docs/pricing.json / scripts/verify_pricing.js のいずれかが
# ステージされた場合のみ実行（通常のコミットは軽量化）
if echo "$STAGED" | grep -qE '(^|/)(index\.html|docs/pricing\.json|scripts/verify_pricing\.js)$'; then
  if ! node scripts/verify_pricing.js > /tmp/_pc_pricing.txt 2>&1; then
    echo "❌ 料金表 SSOT 照合テスト失敗"
    cat /tmp/_pc_pricing.txt
    FAIL=1
  fi
  rm -f /tmp/_pc_pricing.txt
fi

# ===== 4. credential leak simple scan =====
# 主要な credential 漏洩パターンを検出（2026-05-13 拡張）。
# 旧: STAFF_API_KEY 相当の 64 桁 hex のみ
# 新: + Google API Key (AIza...) / OpenAI sk-... / Stripe sk_live_/rk_live_ / GitHub PAT (ghp_...)
#     + Bearer ${long_token} のハードコード / Anthropic sk-ant-...
# 注意: Firebase の apiKey はクライアント公開前提なので除外（漏洩問題なし）。
if [ -n "$STAGED" ]; then
  for f in $STAGED; do
    [ -f "$f" ] || continue
    case "$f" in
      *.html|*.js|*.ts|*.md|*.py|*.sh|*.json|*.yaml|*.yml)
        # Firebase apiKey（AIzaSyDS4b-ukVqd1iiMo7DeRIB2tzKwrt-or10）はクライアント公開OKなので除外
        # 検出パターン：AIza以外のGoogle系、sk-、ghp_、GitHub fine-grained、Bearer 長文字列、Anthropic
        if grep -nE \
          -e "'[a-f0-9]{64}'" \
          -e "sk-[A-Za-z0-9_-]{40,}" \
          -e "sk_live_[A-Za-z0-9]{20,}" \
          -e "rk_live_[A-Za-z0-9]{20,}" \
          -e "ghp_[A-Za-z0-9]{30,}" \
          -e "github_pat_[A-Za-z0-9_]{50,}" \
          -e "sk-ant-[A-Za-z0-9_-]{50,}" \
          -e "Bearer [A-Za-z0-9_.-]{40,}" \
          "$f" > /tmp/_pc_leak.txt 2>/dev/null; then
          # Firebase apiKey（AIzaSyDS4b-…）の正当パターンは除外
          grep -v "AIzaSyDS4b-ukVqd1iiMo7DeRIB2tzKwrt-or10" /tmp/_pc_leak.txt > /tmp/_pc_leak2.txt
          if [ -s /tmp/_pc_leak2.txt ]; then
            echo "⚠️  possible credential leak in: $f"
            cat /tmp/_pc_leak2.txt
            echo "   → 認証情報は Keychain / .env / Secret Manager に保管してください。"
            echo "   → 本当に必要なら --no-verify でバイパス可（社長承認推奨）"
            FAIL=1
          fi
          rm -f /tmp/_pc_leak2.txt
        fi
        ;;
    esac
  done
  rm -f /tmp/_pc_leak.txt
fi

# ===== 5. SHEET_HEADERS 変更検知マーカー =====
# functions/src/lib/sheets.ts（SSOT・2026-05-05 Phase B-1 以降）/ index.ts / constants.ts（legacy 写し）
# の SHEET_HEADERS / SYNC_CLEAR_RANGE_* が変更されている場合、/tmp にマーカーを置く。
# commit-msg hook が読み取って [sheet-schema] タグの有無を強制する。
# （pre-commit 段階では .git/COMMIT_EDITMSG がまだ書かれていない可能性が高いため二段構え）
# 2026-05-13: lib/sheets.ts を watch list に追加（SSOT がそこに移ったが監視漏れていた）。
# services/sheetsSync.ts の SYNC_CLEAR_RANGE_* ハードコードも併せて検出する。
SHEET_HEADER_FILES="functions/src/lib/sheets.ts functions/src/services/sheetsSync.ts functions/src/index.ts functions/src/constants.ts"
rm -f /tmp/_pc_sheet_headers_touched
for f in $SHEET_HEADER_FILES; do
  echo "$STAGED" | grep -qE "(^|/)$(basename $f)\$" || continue
  if git diff --cached "$f" 2>/dev/null | grep -qE "^[+-].*(SHEET_HEADERS|SYNC_CLEAR_RANGE|SHEET_LAST_COLUMN)"; then
    touch /tmp/_pc_sheet_headers_touched
  fi
done

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "pre-commit hook failed. Fix the issues above, or run with --no-verify if you really know what you're doing."
  exit 1
fi

exit 0
